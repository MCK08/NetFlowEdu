# Firebase Web SDK config (safe to expose client-side — security is enforced via Firestore/Storage rules, not secrecy)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to connect to local Firebase Emulator Suite instead of production
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false

# Google Sign-In (Phase 11) — OAuth client ID(s) from Firebase Console
# (Authentication > Sign-in method > Google, "Web SDK configuration") or
# Google Cloud Console > APIs & Services > Credentials. Only the web client
# ID is required for Expo Go / expo-auth-session's browser-based flow; the
# iOS/Android ones are only needed for a future standalone/dev-client build.
# Optional: the "Continue with Google" button/hook simply isn't usable
# until EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is set — nothing else in the app
# depends on it, so leaving this blank does not break anything else.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
