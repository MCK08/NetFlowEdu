rules_version = '2';

// Production-shaped skeleton (questions/solutions paths land fully in Phase
// 3+). Path conventions:
//   /orgs/{organizationId}/questions/{ownerId}/{questionId}/{fileName}
//   /orgs/{organizationId}/solutions/{authorId}/{solutionId}/{fileName}
//   /users/{userId}/avatar/{fileName}
//
// Storage Rules' firestore.get() is unsafe to depend on for access checks
// — a previous phase reproduced it throwing `EvaluationException: Null
// value error` on real requests (see tests/integration/storage.rules.test.ts
// history), which made every getDownloadURL() fail, including for the
// file's own owner. So visibility is encoded directly in the Storage path
// instead of being looked up: every access-level check below is a path
// segment comparison, never a cross-service call.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function organizationId() {
      return request.auth.token.organizationId;
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    match /orgs/{org}/questions/{ownerId}/{questionId}/{fileName} {
      allow read: if isSignedIn() && organizationId() == org;
      allow write: if isSignedIn() && organizationId() == org && uid() == ownerId
                   && isImageOrPdf() && isUnder10MB();
    }

    match /orgs/{org}/solutions/{authorId}/{solutionId}/{fileName} {
      allow read: if isSignedIn() && organizationId() == org;
      allow write: if isSignedIn() && organizationId() == org && uid() == authorId
                   && isImageOrPdf() && isUnder10MB();
    }

    // Phase 6: {accessLevel} is 'public' or 'private', matching
    // src/services/storage/questionImages.ts's upload path construction
    // (derived from the question's chosen visibility — Firestore's 'class'
    // visibility collapses to the 'private' access level here too, since
    // it currently has no real membership check and is owner-only-readable
    // in firestore.rules, same as private). Public images are visible to
    // any authenticated user; private/class images stay owner-only.
    match /questions/public/{ownerId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid() == ownerId
                   && isImageOrPdf() && isUnder10MB();
    }

    match /questions/private/{ownerId}/{fileName} {
      allow read: if isSignedIn() && uid() == ownerId;
      allow write: if isSignedIn() && uid() == ownerId
                   && isImageOrPdf() && isUnder10MB();
    }

    // Phase 7: class questions. Storage still can't safely call
    // firestore.get() (see the file header), so it can't verify "is this
    // uid actually a member of classId" the way firestore.rules' isClassMember
    // does — the best it can check from the path alone is "same
    // organization, signed in". This is a deliberate, narrower-than-ideal
    // trust boundary, same shape as 'public' already accepting "any signed-in
    // user": within-org classmates who are NOT in this specific class could
    // in principle read the blob if they guessed the exact
    // classId/ownerId/timestamp-filename path, but they can never discover
    // that path — the only place imageUrl is exposed is inside the
    // question document itself, which firestore.rules' isClassMember DOES
    // correctly gate. Write only checks path-ownership (uid == ownerId),
    // not "does this uid actually own classId" — same as every other
    // access level here; the real gate on whether a valid class question
    // can ever be created is firestore.rules' create rule on
    // questions/{questionId}, checked immediately after this upload by
    // createQuestion. An orphaned blob with no matching Firestore doc is
    // never linked or discoverable.
    // Phase 9.1: `|| uid() == ownerId` — the uploader may read back the file
    // they just wrote. uploadImage() performs uploadBytes() AND THEN
    // getDownloadURL(); the second call is a READ. Students can now publish
    // class questions, and a student's organizationId claim is always null
    // while this path carries the TEACHER's org, so the org branch alone
    // could never be satisfied by the very user who had just written the
    // bytes — the write succeeded and the next line failed with
    // storage/unauthorized ("Soru yüklenemedi").
    //
    // This grants nothing beyond "read the file you own": {ownerId} is a
    // path segment the writer can only ever have written under their own
    // uid (the write rule enforces uid() == ownerId), so no one gains
    // access to anyone else's image. Same shape as the sibling
    // questions/private/{ownerId} rule.
    match /questions/class/{organizationId}/{classId}/{ownerId}/{fileName} {
      allow read: if isSignedIn() && (organizationId() == organizationId || uid() == ownerId);
      allow write: if isSignedIn() && uid() == ownerId
                   && isImageOrPdf() && isUnder10MB();
    }

    // Phase 6: {accessLevel} mirrors the parent question's, same reasoning
    // as questions/{accessLevel}/... above — an answer image is readable
    // by whoever could read the question, without ever asking Storage to
    // cross-reference Firestore. The client already has the parent
    // Question (Question Detail screen) when uploading an answer, so it
    // can supply this segment directly — see uploadAnswerImage.
    // ---- Phase 17B: answer images are now SERVER-PUBLISHED ---------------
    //
    // READ rules are unchanged, so every answer image already published
    // keeps working and the answer UI needs no change.
    //
    // WRITE is now denied to clients. An answer image is uploaded to the
    // private quarantine path below, analysed (Vision SafeSearch + OCR, with
    // the OCR text run through the Turkish text layer), and only then copied
    // here by submitAnswerForModeration using the Admin SDK, which bypasses
    // these rules entirely.
    //
    // Leaving the old client write open would have defeated the whole gate
    // in the most direct way available: upload straight to the readable
    // path, and the object is served to every classmate without any analysis
    // ever running on it.
    match /answers/public/{questionId}/{ownerId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /answers/private/{questionId}/{ownerId}/{fileName} {
      allow read: if isSignedIn() && uid() == ownerId;
      allow write: if false;
    }

    // ---- Phase 17B: moderation quarantine --------------------------------
    //
    // Where unmoderated answer images live until a decision is made.
    //
    // {uid} is a path segment and the write rule pins it to the caller, so a
    // student can only ever write under their own uid — there is no way to
    // drop a file into someone else's quarantine and have it attributed to
    // them. {submissionId} is minted by the client per gesture and re-checked
    // server-side against the submission it claims to belong to, so a file
    // cannot be smuggled from one submission into another.
    //
    // READ is owner-only, and that is the whole privacy story for pending
    // content: no classmate, no teacher and no unauthenticated request can
    // fetch a quarantined image. The owner may read their own back (upload
    // retry, and they already have the bytes on their device anyway).
    //
    // The client can never write to the approved path, and the server never
    // publishes without a decision, so there is no state in which an
    // unmoderated image is readable by another user.
    //
    // Content type is restricted to real images — narrower than the
    // isImageOrPdf() used elsewhere, because an answer is a photo or a
    // drawing and a PDF is neither. Vision cannot analyse a PDF here either,
    // so accepting one would create content that could never be cleared.
    match /moderation/pending/{ownerId}/{submissionId}/{fileName} {
      allow read: if isSignedIn() && uid() == ownerId;
      allow write: if isSignedIn() && uid() == ownerId
                   && request.resource.contentType in ['image/png', 'image/jpeg']
                   && request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{userId}/avatar/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid() == userId
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
