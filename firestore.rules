rules_version = '2';

// Production-shaped ruleset. Every rule below is deny-by-default; loosen
// only with a named reason in the commit message.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // role/organizationId are mirrored onto the user's custom claims by
    // Cloud Functions (onUserCreate trigger, adminSetUserRole callable)
    // whenever users/{uid} is created or promoted, so rules can check
    // claims directly (fast, no extra read) instead of fetching the doc.
    function role() {
      return request.auth.token.role;
    }

    function organizationId() {
      return request.auth.token.organizationId;
    }

    function isRole(r) {
      return isSignedIn() && role() == r;
    }

    function isPlatformAdmin() {
      return isRole('platform_admin');
    }

    // Phase 90 — isOrgAdmin no longer gates anything. Its only call site was
    // the question delete rule, which now denies every client. It is kept
    // rather than removed because the role itself still exists (see
    // adminSetUserRole) and a future org-admin capability would reach for this
    // exact helper; nothing calls it today.
    function isOrgAdmin() {
      return isRole('organization_admin');
    }

    function isTeacher() {
      return isRole('teacher');
    }

    function isStudent() {
      return isRole('student');
    }

    function sameOrg(resourceOrgId) {
      return isSignedIn() && organizationId() == resourceOrgId;
    }

    function isOwner(resourceOwnerId) {
      return isSignedIn() && uid() == resourceOwnerId;
    }

    // Shared by questions/{questionId}'s own read rule AND anything that
    // gates access on "can the caller read this question" (answers,
    // questionComments), so they can never drift out of sync.
    //
    // 'class' visibility is readable by any member of the target class
    // (student or teacher) — see classes/{classId}/members/{uid} below,
    // written exclusively by the join/create/remove Cloud Functions.
    function canReadQuestionData(data) {
      return data.visibility == 'private' && isOwner(data.ownerId) ||
             data.visibility == 'public' && isSignedIn() ||
             data.visibility == 'class' && isClassMember(data.classId);
    }

    function questionData(qid) {
      return get(/databases/$(database)/documents/questions/$(qid)).data;
    }

    // ---- classes helpers -------------------------------------------------

    function isClassMember(classId) {
      return isSignedIn()
          && exists(/databases/$(database)/documents/classes/$(classId)/members/$(uid()));
    }

    function classData(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    // Used by classes/{classId}/messages' create rule to verify the
    // caller's OWN membership role, rather than trusting a client-submitted
    // senderRole field at face value — the same "never trust a client role
    // claim" invariant this ruleset applies everywhere else (see role()/
    // organizationId() above).
    function classMemberData(classId, memberUid) {
      return get(/databases/$(database)/documents/classes/$(classId)/members/$(memberUid)).data;
    }

    // Whether the caller is allowed to send another class message right
    // now — true if they've never sent one (no rate-limit doc yet) or if
    // at least 1 second has passed since classes/{classId}/messageRateLimits/
    // {uid}'s recorded lastMessageAt. That document is written in the SAME
    // client-side Firestore transaction as the message itself
    // (sendClassMessage), so this is real, server-enforced rate limiting —
    // a modified client can't bypass it by simply not writing the
    // rate-limit doc, because the message create rule below requires it.
    function isWithinClassMessageRateLimit(classId) {
      return !exists(/databases/$(database)/documents/classes/$(classId)/messageRateLimits/$(uid()))
          || request.time > get(/databases/$(database)/documents/classes/$(classId)/messageRateLimits/$(uid())).data.lastMessageAt + duration.value(1, 's');
    }

    // ---- users/{userId} -----------------------------------------------
    //
    // Server-managed fields — role, organizationId, accountStatus,
    // createdAt, uid, email — are set only by
    // Cloud Functions (Admin SDK bypasses these rules entirely). The owner
    // may read their whole profile (nothing here needs to be hidden from
    // them) but may only ever write displayName / photoURL / updatedAt.
    //
    // This document contains email/accountStatus, so it stays strictly
    // owner-only — never readable cross-user. Anything another user is
    // allowed to see about this account lives in publicProfiles/{uid}
    // instead (safe-field copy, see below).

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Only the Cloud Functions onUserCreate trigger creates this
      // document (via the Admin SDK, which isn't subject to these rules),
      // so client-initiated creates are always denied — this is not a
      // gap, it's the intended path.
      allow create: if false;

      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['displayName', 'photoURL', 'updatedAt'])
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.organizationId == resource.data.organizationId
                    // PHASE 113 — totalPoints/weeklyPoints are a removed
                    // system, not a live one: nothing ever awarded them,
                    // onUserCreate no longer writes them, and
                    // functions/scripts/cleanupVestigialPoints.mts deletes
                    // them from the documents that still carry them.
                    //
                    // These stay, in `.get(key, default)` form, for exactly
                    // the reason onboardingStatus below does: a plain `==`
                    // on a map key the document does NOT have throws
                    // ("Property totalPoints is undefined"), which denies
                    // the whole update — verified against the emulator, on
                    // a profile created without the fields. Written the
                    // naive way, this line alone would stop every new
                    // account from editing its own displayName.
                    //
                    // So they hold either way: present-and-equal on a
                    // legacy document (a client still cannot change a
                    // leftover value), absent-and-still-absent afterwards
                    // (a client cannot reintroduce one either).
                    && request.resource.data.get('totalPoints', null)
                       == resource.data.get('totalPoints', null)
                    && request.resource.data.get('weeklyPoints', null)
                       == resource.data.get('weeklyPoints', null)
                    && request.resource.data.accountStatus == resource.data.accountStatus
                    && request.resource.data.createdAt == resource.data.createdAt
                    // onboardingStatus/requestedRole are exclusively
                    // Cloud-Function-managed (see
                    // functions/src/onboarding/{initializeOnboarding,completeOnboarding}.ts).
                    // Every account created before these fields existed has
                    // no such keys at all, and plain `==` on a missing map
                    // key throws ("Property ... is undefined"), not just
                    // evaluates falsy — so this uses .get(key, default) to
                    // treat "absent" as a real, comparable value instead. A
                    // client update is only ever allowed if both fields stay
                    // exactly as they were (present-and-equal, or
                    // absent-and-still-absent) — a client can never set,
                    // clear, or backdate onboarding state, or swap
                    // requestedRole, themselves.
                    && request.resource.data.get('onboardingStatus', null)
                       == resource.data.get('onboardingStatus', null)
                    && request.resource.data.get('requestedRole', null)
                       == resource.data.get('requestedRole', null);

      allow delete: if false;
    }

    // ---- users/{uid}/savedQuestions/{questionId} ------------------------
    // Personal bookmark list. Unlike likes, there's no shared counter to
    // protect (a bookmark only affects the owner's own view), so this is
    // fully client-writable — same trust level as the user's own displayName
    // edit, just a different field. Denormalized snapshot written at save
    // time by the client (see saveQuestion) so listing never needs an extra
    // read per item.

    match /users/{uid}/savedQuestions/{questionId} {
      allow read, write: if isOwner(uid);
    }

    // ---- publicProfiles/{uid} -------------------------------------------
    //
    // Identity-only mirror of users/{uid} — never email/accountStatus/
    // moderation data, and since Phase 112 never any academic measurement
    // either (see functions/src/profiles/publicProfileProjection.ts for the
    // exact contract, written only by syncPublicProfile on a users/{uid}
    // write). Readable by any authenticated user, which is precisely why
    // it carries a username, an avatar and a role and nothing else: this
    // document is what makes cross-user display possible without exposing
    // the owner-only users/{uid} document — or anyone's progress.

    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- questions/{questionId} ----------------------------------------
    // visibility: "private" | "public" | "class"

    // Phase 72 — an optional authored hint ladder is a short, bounded list.
    // Absent/null is always legal (legacy questions and every question whose
    // author added none).
    // Phase 89 — hintsWithinBounds and choiceFeedbackWithinBounds below no
    // longer gate anything: the question create rule they guarded now denies
    // every client write, so `createQuestion` on the server is what bounds
    // these. They are kept because their comments are the clearest record of
    // what rules can and cannot check about authored content, which is the
    // reasoning Phase 89 acted on. Nothing calls them.
    function hintsWithinBounds(data) {
      return !('hints' in data)
             || data.hints == null
             || (data.hints is list && data.hints.size() <= 3);
    }

    // Phase 77 — optional authored feedback per wrong choice, keyed by the
    // same A-E labels `choices` already uses. Absent/null is always legal
    // (every legacy question, and every question whose author attached none).
    //
    // Rules can bound the SHAPE — a map, with at most one entry per real
    // choice label. They deliberately do not try to validate the entries
    // themselves: whether a note names an option this question actually has,
    // and whether it sits on the correct answer, are questions about the
    // relationship between three fields, and choiceFeedback.ts is the one
    // place that check lives on both the write and the read side. Duplicating
    // a weaker version of it here would create a second, drifting authority.
    // Rules can bound the MAP, but cannot iterate it to inspect each entry's
    // fields — the same limitation hintsWithinBounds documents. Per-entry
    // shape (text/conceptKey/semanticDefinitionId/semanticLabel, and the rule
    // that a shared reference drops the private key) is enforced by
    // choiceFeedback.ts's sanitiser on BOTH the write and the read, so a
    // hand-crafted document still cannot surface a malformed entry.
    //
    // Phase 80 note on why a cross-class reference needs no rule here: a
    // shared identity's namespace is taken from the QUESTION's own classId at
    // outcome time, never from the referenced definition. A stale or forged id
    // on a class-B question therefore resolves inside class B and can never
    // reach class A's meaning, whatever it points at.
    function choiceFeedbackWithinBounds(data) {
      return !('choiceFeedback' in data)
             || data.choiceFeedback == null
             || (data.choiceFeedback is map && data.choiceFeedback.keys().size() <= 5);
    }

    match /questions/{questionId} {
      // isOwner(...) is listed first, and separately from
      // canReadQuestionData, on purpose: Firestore's query-provability
      // check is purely syntactic, based on what the *query itself*
      // constrains, never on what's actually stored. getOwnQuestionsPage's
      // query (`where('ownerId','==',uid())`, no visibility filter) lets
      // Firestore statically prove this left-hand branch always holds for
      // every document the query could return (because the query's own
      // equality filter already pins ownerId), so it never needs to
      // inspect `visibility` at all for that query. Folding this into
      // canReadQuestionData instead (visibility-gated on every branch,
      // including the owner one) makes the *whole* rule depend on
      // `visibility`, which the query doesn't constrain — Firestore then
      // refuses to run the query at all: "Property visibility is
      // undefined on object" (reproduced with the emulator against this
      // exact query shape). This also matches questions.ts's own doc
      // comment on getOwnQuestionsPage ("owner can always read their own
      // regardless of visibility"), which the old rule never actually
      // guaranteed at the query level, only for single-document get()s.
      allow read: if isSignedIn() && (isOwner(resource.data.ownerId) || canReadQuestionData(resource.data));

      // Phase 89 — no client may create a question, including a teacher in
      // their own class.
      //
      // WHY THIS IS NOT A PERMISSION REMOVAL
      //
      // Teachers and students both still author questions. They do it through
      // the `createQuestion` callable, which runs on the Admin SDK and is
      // unaffected by this line. What they may no longer do is assemble a
      // question document themselves and hand Firestore the finished article.
      //
      // WHAT THE RULE THIS REPLACES COULD AND COULD NOT DO
      //
      // It was good at identity and was left in place for four phases because
      // of it: ownerId was pinned to the caller, posterRole was checked
      // against the caller's real membership record, the counters had to be
      // zero, and an outsider was refused. Phase 89 re-proved every one of
      // those against the live emulator before touching anything — none of it
      // was forgeable, and none of it is being claimed as newly fixed.
      //
      // What it could not do is judge a question. Rules cannot compare three
      // fields to decide whether the correct answer is among the options, and
      // they cannot read a semanticDefinitions document to ask whether a
      // shared meaning exists, belongs to this class, matches this question's
      // scope, or has been archived. The comment on choiceFeedbackWithinBounds
      // above says exactly that, and it was honest. So the same probe that
      // confirmed identity was safe also created, with a real teacher token, a
      // question dated 2099, a question whose correct answer was an option it
      // did not have, a one-option "multiple choice", a 1000-character hint,
      // an image hosted on another domain, and a mapping to a definition that
      // was archived, belonged to another class, sat in another subject, and
      // in one case did not exist at all — each carrying whatever label the
      // payload felt like claiming.
      //
      // Those are the writes this line ends. The server now decides what a
      // question is, which is the only place that judgement can be made.
      allow create: if false;

      // answerCount/likeCount/commentCount are maintained only by trusted
      // Cloud Functions (Admin SDK bypasses these rules) — don't trust the
      // client to increment any of them. visibility/classId/posterRole are
      // immutable once created (no "constrained transition" matrix needed
      // if they just never change) — posterRole/classId were added to this
      // freeze list in Phase 9.1 alongside the fields themselves, so an
      // owner's own edit (e.g. correcting subject/description) can never
      // also smuggle in a posterRole change.
      // Phase 88 — no client may update a question, including its owner.
      //
      // WHY THIS IS NOT A PERMISSION REMOVAL
      //
      // An owner may still revise their question; they do it through the
      // `updateQuestionRevision` callable, which runs on the Admin SDK and is
      // therefore unaffected by this line. What they may no longer do is reach
      // the document directly and skip what that callable enforces: the
      // ownership re-check, the stale-draft comparison, the Phase 72/77/80
      // sanitisers, and the scope/archive validation on a newly referenced
      // shared definition. Phase 87 built those checks but could only apply
      // them to its own code path, and proved an owner could PATCH around
      // them — this is the half that closes.
      //
      // WHY `false` IS THE NARROWEST RULE, NOT THE BLUNTEST
      //
      // A full audit of every client write to `questions/{id}` found exactly
      // two: `addDoc` (create, below/above) and the revision transaction that
      // has now moved server-side. There is no third legitimate client update
      // to preserve, so a narrower rule would only be narrower in appearance.
      // The three engagement counters were never client-writable either — they
      // are maintained by onAnswerCreate, toggleQuestionLike and
      // commentCounters, all Admin SDK, all unaffected by this.
      allow update: if false;

      // Phase 90 — no client may delete a question either. With create (Phase
      // 89) and update (Phase 88) already server-only, this closes the
      // lifecycle: a question's existence is decided entirely on the server.
      //
      // WHAT THIS REMOVES, AND WHY THAT IS NOT A REGRESSION
      //
      // The rule above granted deletion to the owner, to an org admin, to a
      // class's own teacher, and — for private/public questions — to any
      // teacher at all. Phase 90 searched the entire repository for something
      // that used it and found NOTHING: no delete button on any question
      // surface, no client service, no Cloud Function, no admin or moderation
      // path, and no ROADMAP intent. The only destructive affordances in the
      // product are comment deletion and class-member removal. This was a
      // rules capability with no product path, the same shape as the Phase 9.1
      // student-edit capability Phase 88 retired.
      //
      // It was also the one place a class teacher could destroy a student's
      // authored work. Phases 86 through 89 all refuse exactly that — a class
      // contains questions authored by its students, and owning the classroom
      // is not owning their work — so leaving it here contradicted every other
      // ownership decision in the question lifecycle.
      //
      // WHAT DELETION WOULD COST IF IT WERE ADDED
      //
      // Measured against the emulator rather than guessed at. Hard deletion is
      // evidence-SAFE: studyEvents stay byte-identical, studyItems are
      // untouched, a savedQuestions bookmark survives on its own denormalized
      // snapshot, semanticDefinitions are untouched, and both recordStudyOutcome
      // and updateQuestionRevision refuse a missing question with a clean
      // not-found rather than recreating it. The study system already treats a
      // question that no longer resolves as "gone" by design (Phases 22/28/68).
      //
      // What it does leave behind is orphans: questionComments and
      // questionLikes rows, the Storage image, and a dangling id inside any
      // assignment's questionIds. None of that is fixed by a rule, which is
      // precisely why removal belongs behind a server gateway whenever the
      // product actually wants it — built then, with its UI, the way Phase 89
      // built creation. Admin SDK paths are unaffected and can still remove a
      // question today.
      allow delete: if false;
    }

    // ---- organizations/{organizationId} ---------------------------------
    // A teacher's personal workspace, created exclusively by
    // completeOnboarding (Admin SDK) when a new account picks "teacher" at
    // registration — see functions/src/onboarding/completeOnboarding.ts.
    // Never client-writable, matching every other server-managed collection
    // in this file. Read is limited to the owner — nothing today needs a
    // student or another teacher to read someone else's organization doc
    // directly (class access is already gated by class membership, not by
    // reading the organization itself).
    match /organizations/{organizationId} {
      allow read: if isOwner(resource.data.ownerId);
      allow write: if false;
    }

    // ---- classes/{classId} ---------------------------------------------
    // Every field here (joinCode especially) is Cloud-Function-managed —
    // see functions/src/classes/. A client `create`/`update` would let a
    // teacher mint their own join code (bypassing the uniqueness reservation
    // in classJoinCodes/{code}) or silently rewrite memberCount, so all
    // writes are denied and funneled through createClass /
    // regenerateClassJoinCode / joinClassByCode / leaveClass /
    // removeClassMember instead — same pattern as usernames/{username}.
    //
    // Read is restricted to the owning teacher or a current member (not
    // "anyone in the org") because the document contains the join code
    // itself: any org member being able to read it would let them join
    // without ever being given the code, defeating its purpose. A member
    // already has the code (they used it to join), so exposing it back to
    // them leaks nothing new.
    match /classes/{classId} {
      allow read: if isSignedIn() && (resource.data.teacherId == uid() || isClassMember(classId));
      allow write: if false;
    }

    // ---- classes/{classId}/members/{memberUid} --------------------------
    // Membership is exclusively Cloud-Function-managed (joinClassByCode /
    // leaveClass / removeClassMember) so a student can never add themselves
    // (or anyone else) directly, and memberCount on the parent class can
    // never desync from the actual member docs.
    //
    // Phase 110 — "Sınıf Arkadaşların". A CURRENT member of a class may read
    // the member rows of THAT class. What a row holds is fixed by its only
    // writers (joinClassByCode / createClass): uid, role, joinedAt, and the
    // displayName/username/photoURL snapshot taken at join time — the same
    // public identity class chat, comments and questions already show. It
    // holds no email, no study data and no progress, so opening it to
    // classmates exposes nothing that membership did not already reveal.
    //
    // Scope stays one class: isClassMember is keyed on the {classId} in the
    // path, so a member of class A gets nothing from class B, a removed member
    // loses the roster the moment their own row is deleted, and the
    // collection-group rule below still lets a caller list only their OWN
    // membership rows across classes. isClassMember is evaluated before
    // classData so a missing class never reaches a failed get().
    match /classes/{classId}/members/{memberUid} {
      allow read: if isSignedIn()
                  && (isOwner(memberUid)
                      || isClassMember(classId)
                      || classData(classId).teacherId == uid());
      allow write: if false;
    }

    // ---- classes/{classId}/pulse/{weekKey} -------------------------------
    // Phase 110 — "Bu Haftanın Sınıf İlerlemesi". A server-maintained weekly
    // AGGREGATE of the class's own study activity (functions/src/classes/
    // classPulse.ts, the only writer): counts only — no uid, no name, no
    // per-student figure, and therefore nothing that can order students.
    // Readable by the class's members and teacher; written by nobody else.
    //
    // Its bookkeeping (pulse/{weekKey}/participants/{uid} and
    // pulse/{weekKey}/events/{eventId}, which make counting exactly-once and
    // distinct) is matched by no rule here and so falls to the default deny
    // at the bottom of this file: a client can never read who took part.
    match /classes/{classId}/pulse/{weekKey} {
      allow read: if isSignedIn()
                  && (isClassMember(classId) || classData(classId).teacherId == uid());
      allow write: if false;
    }

    // Collection-group scope for the SAME member documents.
    //
    // Production bug: a student joined with a valid code (joinClassByCode
    // returned HTTP 200, membership really was created) but "Sınıflarım"
    // stayed empty and no error was shown. getStudentClasses reads the class
    // list with a COLLECTION GROUP query:
    //     query(collectionGroup(db, "members"), where("uid", "==", uid))
    // A path-scoped rule like the one directly above does NOT apply to
    // collection group queries — Firestore matches them only against
    // recursive-wildcard rules — so the query matched nothing and fell
    // through to the default deny at the bottom of this file (reproduced in
    // the emulator: "false for 'list'" against the catch-all).
    //
    // Checks the `uid` FIELD rather than the {memberUid} document id
    // deliberately: the query filters on exactly that field, which is what
    // makes this statically provable for a `list` operation. The practical
    // effect is that a caller can only ever list membership rows that are
    // their own — strictly narrower than the path-scoped rule above (no
    // teacher branch here), so this grants no access that rule didn't
    // already imply for the caller's own documents.
    //
    // Writes stay denied everywhere; membership is Cloud-Function-only.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == uid();
      allow write: if false;
    }

    // ---- classes/{classId}/messages/{messageId} --------------------------
    // Class chat (Phase 9). Readable/writable only by a current member of
    // the class — the teacher included, since createClass adds them as a
    // member with role 'teacher' (see functions/src/classes/createClass.ts),
    // so no separate teacher-only branch is needed here the way
    // classes/{classId} itself needs one.
    //
    // No `where` clause is needed for the list query that reads this
    // collection (classId/{classId}/messages, ordered by createdAt) — the
    // path itself scopes to one class's subcollection, so this needs no
    // composite index, same reasoning as savedQuestions' single-field
    // orderBy.
    //
    // senderRole is verified against the caller's OWN membership record
    // (classMemberData) rather than trusted from the client — a student can
    // never post a message claiming senderRole == 'teacher'.
    //
    // Immutable after creation, same shape as questionComments minus the
    // owner-delete allowance: editedAt/deleted exist on the model for a
    // future edit/delete feature, but this phase only ever writes them as
    // null/false and never changes them, so update/delete are fully denied
    // for now rather than partially/inconsistently allowed.
    //
    // Rate-limited to 1 message/second per sender — see
    // isWithinClassMessageRateLimit and classes/{classId}/messageRateLimits/
    // {uid} below. clientMessageId is a non-empty client-generated
    // correlation id (optimistic-UI reconciliation only — carries no
    // authorization meaning, just required to be present).
    // Phase 80 — one class's shared instructional vocabulary.
    //
    // WHY THE CLASS OWNS IT
    //
    // This is the only scope in this ruleset that more than one question
    // author can legitimately share: the class's own teacher authors
    // questions in it, and so do its student members (see questions'
    // create rule). A definition is what lets two of those authors point at
    // the SAME meaning on purpose, instead of the product guessing that two
    // typed strings meant the same thing.
    //
    // WHO MAY MANAGE IT
    //
    // The class's teacher, and nobody else. Students read it — a student's own
    // class question may reference a definition the teacher curated — but they
    // never create, rename or retire one. Reusing classData(classId).teacherId
    // rather than inventing a second membership notion keeps this consistent
    // with every other class-scoped rule here.
    //
    // WHY THERE IS NO DELETE
    //
    // Questions reference definitions by id, and studyEvents record that id
    // permanently. Deleting one would leave both pointing at nothing and would
    // silently break a student's historical pattern. `archived` retires a
    // definition from new selection while leaving every existing reference
    // valid, which is the only safe shape.
    match /classes/{classId}/semanticDefinitions/{definitionId} {
      allow read: if isSignedIn()
                  && (classData(classId).teacherId == uid() || isClassMember(classId));

      allow create: if isSignedIn()
                    && isTeacher()
                    && classData(classId).teacherId == uid()
                    && request.resource.data.classId == classId
                    && request.resource.data.createdBy == uid()
                    && request.resource.data.label is string
                    && request.resource.data.label.size() > 0
                    && request.resource.data.label.size() <= 60
                    && (request.resource.data.description == null
                        || (request.resource.data.description is string
                            && request.resource.data.description.size() <= 200))
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() > 0
                    && request.resource.data.subject.size() <= 40
                    && request.resource.data.topic is string
                    && request.resource.data.topic.size() > 0
                    && request.resource.data.topic.size() <= 80
                    // A definition is born active. Creating one already
                    // archived would be a document nothing can ever select.
                    && request.resource.data.archived == false
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      // Only presentation and retirement may change. The four identity-bearing
      // fields are pinned to their stored values: a definition that could
      // change class, scope or author would retroactively re-group every
      // pattern that ever referenced it, which is exactly the silent rewrite
      // this whole design refuses.
      allow update: if isSignedIn()
                    && isTeacher()
                    && classData(classId).teacherId == uid()
                    && request.resource.data.classId == resource.data.classId
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.subject == resource.data.subject
                    && request.resource.data.topic == resource.data.topic
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.archived is bool
                    && request.resource.data.label is string
                    && request.resource.data.label.size() > 0
                    && request.resource.data.label.size() <= 60
                    && (request.resource.data.description == null
                        || (request.resource.data.description is string
                            && request.resource.data.description.size() <= 200))
                    && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /classes/{classId}/messages/{messageId} {
      allow read: if isSignedIn() && isClassMember(classId);

      allow create: if isSignedIn()
                    && isClassMember(classId)
                    && isWithinClassMessageRateLimit(classId)
                    && request.resource.data.classId == classId
                    && request.resource.data.senderId == uid()
                    && request.resource.data.senderRole == classMemberData(classId, uid()).role
                    && request.resource.data.senderName is string
                    && (request.resource.data.senderPhoto == null || request.resource.data.senderPhoto is string)
                    && request.resource.data.clientMessageId is string
                    && request.resource.data.clientMessageId.size() > 0
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.editedAt == null
                    && request.resource.data.deleted == false;

      // Phase 102 — still no client update or delete. The one change a
      // message can undergo (the class teacher removing a student's message)
      // happens through the removeClassMessage Cloud Function, which is
      // what makes it authoritative, class-scoped and retry-safe.
      allow update: if false;
      allow delete: if false;
    }

    // ---- classes/{classId}/chatReads/{memberUid} ------------------------
    // Phase 102 — one read cursor per (class, member): the newest message
    // this member has OPENED the conversation on. This is what backs the
    // sender's "Görüldü" — and because a class chat is a group, it is one
    // document per recipient, never a single seenAt on the message.
    //
    // A member writes only their OWN cursor, and only to a message that
    // actually exists in this class: lastReadAt must equal that message's
    // stored createdAt (a get() on the message, so a cursor can never point
    // past the conversation or at an invented time). The cursor is
    // monotonic — an update may not move it backwards — and updatedAt is
    // the server's clock. Any member may read the cursors, which is what
    // lets a sender see who has caught up; there is no presence, typing or
    // "online" signal here and none of these fields could carry one.
    function chatReadMessageCreatedAt(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)/messages/$(request.resource.data.lastReadMessageId)).data.createdAt;
    }

    function isValidChatRead(classId) {
      return request.resource.data.keys().hasOnly(['lastReadMessageId', 'lastReadAt', 'updatedAt'])
          && request.resource.data.lastReadMessageId is string
          && request.resource.data.lastReadMessageId.size() > 0
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.lastReadAt == chatReadMessageCreatedAt(classId)
          && request.resource.data.updatedAt == request.time;
    }

    match /classes/{classId}/chatReads/{memberUid} {
      allow read: if isSignedIn() && isClassMember(classId);
      allow create: if isSignedIn()
                    && isOwner(memberUid)
                    && isClassMember(classId)
                    && isValidChatRead(classId);
      allow update: if isSignedIn()
                    && isOwner(memberUid)
                    && isClassMember(classId)
                    && isValidChatRead(classId)
                    && request.resource.data.lastReadAt >= resource.data.lastReadAt;
      allow delete: if false;
    }

    // ---- classes/{classId}/messageRateLimits/{uid} -----------------------
    // One document per (class, member) recording the sender's own last
    // message timestamp — written by the CLIENT in the same Firestore
    // transaction as the message itself (sendClassMessage), and read by the
    // messages/{messageId} create rule above to enforce a real 1
    // message/second limit. A caller may only ever write their OWN
    // document (isOwner(uid)), and the value must be exactly request.time
    // (the server's clock) — never a client-supplied timestamp, so a
    // modified client can't backdate it to defeat the check.
    match /classes/{classId}/messageRateLimits/{memberUid} {
      allow read: if isOwner(memberUid);
      allow create, update: if isSignedIn()
                            && isOwner(memberUid)
                            && isClassMember(classId)
                            && request.resource.data.lastMessageAt == request.time;
      allow delete: if false;
    }

    // ---- solutions/{solutionId} ------------------------------------------

    match /solutions/{solutionId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if isSignedIn() && request.resource.data.authorId == uid();
      allow update: if isOwner(resource.data.authorId)
                    && request.resource.data.verified == resource.data.verified;
      allow delete: if isOwner(resource.data.authorId) || isTeacher();
    }

    // ---- leaderboards/{leaderboardId} -------------------------------------
    //
    // REMOVED in Phase 112. Nothing wrote this collection and nothing read
    // it — no Function, no screen, no service — but the rule still granted
    // every member of an organization read access to a ranking by score,
    // which is the one social surface this product has decided it will not
    // have (Phase 110). With no match block, these documents are denied by
    // default, so a legacy document left in a project cannot be read.
    // Do not reintroduce: ranking is not a missing feature here.

    // ---- answers/{answerId} --------------------------------------------
    // An answer is readable by anyone who can read its parent question.

    match /answers/{answerId} {
      allow read: if isSignedIn()
                  && exists(/databases/$(database)/documents/questions/$(resource.data.questionId))
                  && canReadQuestionData(questionData(resource.data.questionId));

      // Phase 17B: BACKEND-ONLY CREATION.
      //
      // An answer is an IMAGE — a photo or a drawing, with no text field at
      // all — so nothing about it can be judged without actually looking at
      // the picture. It is now created only by submitAnswerForModeration
      // (Admin SDK), after Vision SafeSearch has cleared the image AND the
      // OCR text has cleared the same Turkish deterministic layer that
      // guards comments.
      //
      // Denying the client here is what makes that unbypassable. Previously
      // a modified client could write this document directly, and
      // onAnswerCreate would then increment answerCount and notify the
      // question owner for content nothing had inspected. The trigger is
      // deliberately unchanged: an answer document now only ever exists if
      // it was approved, so the counter and the notification are gated by
      // construction rather than by adding checks inside the trigger.
      allow create: if false;

      // Phase 94 — no client may update an answer.
      //
      // WHAT THE RULE HERE USED TO SAY, AND WHAT IT ACTUALLY DID
      //
      // It allowed the answer's owner to update, freezing ownerId, questionId,
      // method, imageUrl and createdAt, and its comment claimed "likeCount is
      // maintained only by toggleAnswerLike (Admin SDK) ... nothing else may
      // ever change". The freeze list was real — Phase 94 re-proved each of
      // those five is refused — but it did not include likeCount, and a rule
      // cannot enforce a field it does not name.
      //
      // So the comment was wrong about the one field that mattered. Measured
      // against the emulator with a real token: the answer's own author PATCHed
      // likeCount from 0 to 9999 and it was stored. They could also add
      // arbitrary new fields the schema never defined. That quietly undoes
      // Phase 92, which had just made answer likes deterministic,
      // transactional and floored at zero — a counter is not protected if its
      // subject can simply write it.
      //
      // There is no product feature to preserve: the client answer service
      // exposes a subscription and nothing else, and AnswerCard's only
      // affordances are zooming the image and opening a profile. No edit-answer
      // screen, service or hook exists. This closes a capability nothing used.
      //
      // toggleAnswerLike is unaffected — it runs on the Admin SDK, which
      // bypasses these rules, and remains the only writer of likeCount.
      allow update: if false;

      // Phase 94 — and no client may delete one either.
      //
      // The previous rule allowed the answer's own owner, and correctly refused
      // everyone else including the question's owner; Phase 94 re-proved both
      // halves. But nothing in the product ever called it — there is no delete
      // affordance on an answer and no client service for it, the same shape as
      // the question-delete capability Phase 90 retired.
      //
      // It was also unsafe to use. answerCount is incremented by onAnswerCreate
      // and there is NO corresponding delete trigger, so any answer deletion
      // would leave questions/{id}.answerCount permanently overstating reality.
      // A removal feature, if the product ever wants one, needs a gateway that
      // answers that — built then, with its UI, the way Phase 93 built comment
      // deletion. Admin SDK paths are unaffected.
      allow delete: if false;
    }

    // ---- questionLikes/{likeId} -----------------------------------------
    // Doc id: `${questionId}_${userId}` (deterministic — see
    // functions/src/social/toggleQuestionLike.ts). Written exclusively by
    // that callable (Admin SDK, transactional with questions/{id}.likeCount)
    // so a client can never fake a like or desync the count. Clients may
    // read only their own like record, to render "did I like this".
    //
    // `resource == null` guards a get() on a like the caller hasn't cast
    // yet (the common case — most question/answer pairs have none): for a
    // non-existent document `resource` is null, and dereferencing
    // `resource.data` on it is a rule-evaluation error, which Firestore
    // surfaces to the client as permission-denied (confirmed on a real
    // device — see getMyLikeState's "missing doc just means not liked yet"
    // comment, which was wrong before this fix). Checking `resource == null`
    // first lets a missing like resolve to "not found" the same as any
    // other client read, before ever touching `.data`.

    match /questionLikes/{likeId} {
      allow read: if resource == null || isOwner(resource.data.userId);
      allow write: if false;
    }

    // ---- answerLikes/{likeId} -------------------------------------------
    // Same pattern as questionLikes — see toggleAnswerLike.ts.

    match /answerLikes/{likeId} {
      allow read: if resource == null || isOwner(resource.data.userId);
      allow write: if false;
    }

    // ---- questionComments/{commentId} -----------------------------------
    // Readable by anyone who can read the related question (same
    // canReadQuestionData indirection as answers). No edit feature this
    // phase — update is fully denied. Only the comment's own owner may
    // delete it (admin moderation deferred to a later phase, per spec).

    match /questionComments/{commentId} {
      allow read: if isSignedIn()
                  && exists(/databases/$(database)/documents/questions/$(resource.data.questionId))
                  && canReadQuestionData(questionData(resource.data.questionId));

      // Phase 17: BACKEND-ONLY CREATION.
      //
      // A comment used to be written straight from the client and was live
      // to every reader of the question the instant it landed — the comment
      // counter and the question-owner notification both fire off the
      // resulting onDocumentCreated trigger, so abusive text was counted and
      // announced before anything looked at it.
      //
      // The only writer now is submitQuestionCommentForModeration (Admin
      // SDK, bypasses these rules), which publishes a comment ONLY after the
      // text has passed the moderation decision layer. Denying the client
      // here is what makes that gate unbypassable: a modified client cannot
      // skip the callable and write the document itself.
      //
      // The counter/notification triggers are deliberately unchanged — a
      // comment document now only ever exists if it was approved, so
      // "pending content must not trigger counters" holds by construction.
      allow create: if false;

      allow update: if false;

      // Phase 93 — comment deletion moved to the `deleteQuestionComment`
      // callable, so no client may delete one directly, including its author.
      //
      // WHAT THIS IS AND IS NOT
      //
      // It is NOT a removal of the author's right to delete their own comment —
      // that is a real product feature (the trash affordance on one's own
      // comment in CommentItem) and it still works; it now runs through a
      // server gateway that reads the stored document to decide, the same way
      // create has since Phase 17. The two ends of one lifecycle answered to two
      // different authorities until now.
      //
      // It is also NOT a widening. Phase 93 probed the rule this replaces with
      // real tokens first: another student, the question's OWN owner and an
      // outsider were already refused, and the callable refuses them too. Owning
      // a question does not make someone the moderator of the conversation under
      // it, and teaching the class does not either.
      //
      // commentCount is unaffected: onQuestionCommentDelete fires on the
      // callable's Admin SDK delete exactly as it did on the client's, so the
      // counter keeps one side-effect owner rather than two.
      allow delete: if false;
    }

    // ---- moderationSubmissions/{submissionId} ----------------------------
    // Phase 17. Content awaiting a publication decision.
    //
    // Written EXCLUSIVELY by the moderation callables (Admin SDK). Every
    // client write is denied — not narrowed, denied — because every field
    // here is a trusted field: a client that could set status='approved' or
    // publishedEntityId would have defeated the entire gate, and one that
    // could set reviewedBy would forge an audit trail.
    //
    // Read is author-only and deliberately narrow. The author may see their
    // own submission (the client maps status onto a neutral message); no
    // other student may read it, so pending and rejected content is never
    // visible to anyone but its author. Reviewer access is NOT granted here:
    // the review queue is a server-side callable, so a reviewer never needs
    // a direct client read, and granting one would mean choosing between a
    // teacher-wide or org-wide read rule that could not be scoped to a
    // single class without a get() per document.
    match /moderationSubmissions/{submissionId} {
      allow read: if isSignedIn() && resource.data.authorId == uid();
      allow write: if false;
    }

    // ---- users/{uid}/moderationMeta/{docId} -------------------------------
    // Server-owned submission throttle and (future) abuse summary. Same
    // owner-only-read / never-client-writable contract as socialMeta,
    // notificationMeta and studyMeta.
    //
    // lastSubmissionAt is written from SERVER time inside the submission
    // transaction, never from a client-supplied timestamp — a device with a
    // rewound clock cannot widen its own rate limit.
    match /users/{uid}/moderationMeta/{docId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- friendships/{pairId} --------------------------------------------
    // Phase 10. Doc id is deterministic — sorted([uidA,uidB]).join("_"), see
    // functions/src/friends/pairId.ts — so there can only ever be one
    // relationship per pair of users, by construction (no query needed to
    // discover "do we already have a doc"). Every mutation goes through a
    // callable (Admin SDK, bypasses these rules) — see functions/src/friends/
    // — never a direct client write, same trust model as classes/{classId}
    // and classJoinCodes. Read is scoped to the two participants only: a
    // student's or teacher's friendships are never a public/roster-like
    // surface (spec explicitly forbids a public friend list).
    // Three OR branches, each provable from a DIFFERENT single pinned field
    // — the three real query shapes this app runs (friends list pins
    // participantIds via array-contains; incoming/outgoing pin recipientId/
    // requesterId via equality) each only ever need ONE of these branches,
    // never a field the query itself leaves unconstrained. participantIds
    // is always exactly [requesterId, recipientId] sorted, so all three
    // branches are equivalent in meaning — kept separate only so each
    // query shape has its own directly provable path (same "pin the field
    // the rule needs" discipline as questions/{questionId}'s own read rule).
    match /friendships/{pairId} {
      allow read: if isSignedIn() && (
        uid() in resource.data.participantIds ||
        resource.data.requesterId == uid() ||
        resource.data.recipientId == uid()
      );
      allow write: if false;
    }

    // ---- users/{uid}/socialMeta/{docId} -----------------------------------
    // Exact, server-controlled counters (friendCount/incomingRequestCount/
    // outgoingRequestCount) — see functions/src/friends/socialMeta.ts, the
    // only writer (transactional, alongside every friendship mutation).
    // Owner-only read, same boundary as users/{uid} itself; never
    // client-writable.
    match /users/{uid}/socialMeta/{docId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- users/{uid}/notifications/{notificationId} -----------------------
    // Phase 15 — written exclusively by createNotificationInTransaction /
    // deleteNotificationInTransaction (Admin SDK, from inside an
    // already-audited backend transaction — see
    // functions/src/notifications/createNotification.ts). A client can
    // never fabricate a notification for itself or anyone else, and can
    // never read another user's inbox.
    //
    // Pre-commit hardening: client update access was REMOVED entirely.
    // The original "owner may flip isRead/readAt" rule let a client mark a
    // notification read directly, but nothing in that path ever touched
    // users/{uid}/notificationMeta/summary.unreadCount — the two documents
    // would silently drift (the badge would never actually go down). Both
    // single-notification read (markNotificationRead) and "mark all"
    // (markAllNotificationsRead) are now exclusively Cloud Functions
    // callables that update isRead/readAt AND the summary counter
    // atomically in the same transaction — see
    // functions/src/notifications/markNotificationRead.ts. A client has no
    // remaining way to write to this collection at all; read-only,
    // owner-scoped, full stop. This is simpler than a field-allowlisted
    // update rule and closes the drift bug by construction rather than by
    // convention.
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ---- users/{uid}/notificationMeta/{docId} ------------------------------
    // Exact, server-controlled unread counter — see
    // functions/src/notifications/notificationMeta.ts, the only writer
    // (transactional, alongside every notification create/delete/mark-all
    // mutation). Same owner-only-read / never-client-writable boundary as
    // users/{uid}/socialMeta/{docId} above.
    match /users/{uid}/notificationMeta/{docId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- users/{uid}/sentKudos/{kudosId} ---------------------------------
    // Phase 110 — the SENDER's own record of a "Tebrik Et", written only by
    // the sendClassKudos callable (functions/src/classes/sendClassKudos.ts)
    // in the same transaction as the recipient's notification. It exists so
    // the sender's button can say "Tebrik edildi" after a reload.
    //
    // Owner-only on both sides: the sender reads their sent records here, the
    // recipient reads their received ones as notifications. No one else can
    // read either, so no public count of congratulations exists anywhere —
    // there is nothing to rank or to be popular by.
    match /users/{uid}/sentKudos/{kudosId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- users/{uid}/studyItems/{questionId} -------------------------------
    // Phase 16 — the adaptive review queue. Written exclusively by the
    // recordStudyOutcome callable (Admin SDK, inside a two-phase
    // transaction alongside the summary and the daily stats), so a client
    // can never fabricate progress, backdate a review, forge a mastery
    // count, or bring its own nextReviewAt forward to skip a wait.
    //
    // Read is owner-only, PLUS (Phase 27) the teacher of the class this
    // ONE item came from — never a blanket "any teacher in the org" or
    // "the student's whole study history" grant. `sourceClassId` is
    // written by recordStudyOutcome itself (see functions/src/study/
    // recordStudyOutcome.ts), server-authoritative and non-null only for
    // an item studied from a real class question — so this can never
    // expose a student's private/public study activity to a teacher, only
    // the activity that happened inside that teacher's own classroom.
    //
    // Provability for the LIST query the dashboard actually runs
    // (`where('sourceClassId','==',classId)`, see
    // teacherClassPerformance.ts's getClassSourcedStudyItems): the query's
    // own equality filter pins `sourceClassId`, so Firestore can resolve
    // `resource.data.sourceClassId` for every candidate document without
    // touching any other unconstrained field — the exact same
    // "pin the field the query already pins" reasoning
    // getClassQuestionsPage's own rule comment documents for
    // questions/{questionId}.
    //
    // These documents still contain NO question content (no image, no
    // description) — only scheduling state plus the questionId — so this
    // never leaks private/class material beyond what the teacher already
    // has legitimate access to as that class's own teacher.
    match /users/{uid}/studyItems/{questionId} {
      allow read: if isOwner(uid)
                  || (isTeacher()
                      && resource.data.sourceClassId is string
                      && classData(resource.data.sourceClassId).teacherId == uid()
                      && classMemberData(resource.data.sourceClassId, uid).role == 'student');
      allow write: if false;
    }

    // ---- users/{uid}/studyEvents/{eventId} ---------------------------------
    // Phase 59 — the append-only chronological learning history. Written
    // exclusively by the recordStudyOutcome callable (Admin SDK), inside the
    // SAME transaction that updates the study item's cumulative counters, so
    // a client can never forge an outcome, backdate an event to manufacture a
    // recovery narrative, or attribute one to another student.
    //
    // `allow write: if false` is what makes these documents immutable AND
    // undeletable from every client path: there is no create, no update and
    // no delete a signed-in user can perform, so a recorded outcome cannot be
    // rewritten after the fact.
    //
    // Read follows users/{uid}/studyItems EXACTLY — owner, plus the teacher of
    // the class that ONE event came from. `sourceClassId` is server-written
    // (see functions/src/study/recordStudyOutcome.ts) and is non-null only for
    // an outcome recorded on a real class question, so a teacher can never see
    // a student's private or public study history, only what happened inside
    // their own classroom.
    //
    // Provability for the teacher's LIST query
    // (`where('sourceClassId','==',classId).orderBy('occurredAt','desc')`):
    // the query's own equality filter pins `sourceClassId`, so Firestore can
    // resolve `resource.data.sourceClassId` for every candidate document
    // without touching an unconstrained field — the same "pin the field the
    // query already pins" reasoning studyItems' own rule documents.
    //
    // These documents carry NO question content (no image, no description, not
    // even subject/topic — see functions/src/study/learningEvent.ts), so this
    // never widens access to material beyond what the reader already has.
    match /users/{uid}/studyEvents/{eventId} {
      allow read: if isOwner(uid)
                  || (isTeacher()
                      && resource.data.sourceClassId is string
                      && classData(resource.data.sourceClassId).teacherId == uid()
                      && classMemberData(resource.data.sourceClassId, uid).role == 'student');
      allow write: if false;
    }

    // ---- users/{uid}/studyMeta/{docId} -------------------------------------
    // Server-owned progress summary (streak, mastered count, daily goal) —
    // exactly the same owner-only-read / never-client-writable contract as
    // users/{uid}/socialMeta and users/{uid}/notificationMeta. The daily
    // goal is changed through the setStudyDailyGoal callable, which range-
    // validates it, rather than by a direct client write.
    match /users/{uid}/studyMeta/{docId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- questionStats/{questionId} ----------------------------------------
    // Phase 108 — the anonymous community cohort for one question: how many
    // DISTINCT students recorded an outcome on it and how many of those have
    // struggle evidence, plus the band derived from them. Maintained only by
    // recordStudyOutcome (Admin SDK) inside the outcome's own transaction; no
    // client can write, so a cohort can never be inflated or a band forged.
    //
    // Read is a single-document get, gated on the SAME question access the
    // question itself has (canReadQuestionData): a student who cannot open a
    // question learns nothing about how hard it was for others. No list
    // query is provable under this rule, and none is offered — discovery
    // goes through the listCommunityDifficultQuestions callable, which
    // filters by the caller's access server-side. The document contains no
    // uid, name, answer or history — nothing in it names a person.
    match /questionStats/{questionId} {
      allow get: if isSignedIn() && canReadQuestionData(questionData(questionId));
      allow list: if false;
      allow write: if false;
    }

    // ---- users/{uid}/studyDays/{dayKey} ------------------------------------
    // Per-calendar-day counters. The day key itself is derived SERVER-side
    // from server time plus a validated IANA timezone (see
    // functions/src/study/dayKey.ts) — a client that could write these
    // could mint an unlimited streak by replaying the same day.
    match /users/{uid}/studyDays/{dayKey} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- assignments helper -----------------------------------------------
    function assignmentData(assignmentId) {
      return get(/databases/$(database)/documents/assignments/$(assignmentId)).data;
    }

    // ---- assignments/{assignmentId} ---------------------------------------
    // Phase 29 — a teacher-authored ORCHESTRATION document: WHICH questions
    // (a snapshot, never re-derived after creation) go to WHICH students
    // (also a snapshot), by when. Never touches studyItems/studyDays/
    // studyMeta — those stay exclusively recordStudyOutcome's (Admin SDK);
    // this collection only records the teacher's own assignment metadata,
    // and (in its submissions subcollection below) each targeted student's
    // own completion progress against it.
    match /assignments/{assignmentId} {
      // A teacher may read their own class's assignments (their own
      // getClassAssignments query, classId-equality only — resource.data.
      // classId is always defined, so classData(...) is always
      // well-defined here, same "the field the query itself pins is always
      // safe to read" reasoning questions/{questionId}'s own read rule
      // documents at length). A targeted student may read an assignment
      // naming them — targetStudentIds is a required field on every
      // document (enforced by the create rule below), so this branch is
      // equally well-defined for every document either query could ever
      // return; array-contains membership provability is the same
      // established pattern.
      allow read: if isSignedIn()
                  && (
                       (isTeacher() && classData(resource.data.classId).teacherId == uid())
                       || uid() in resource.data.targetStudentIds
                     );

      allow create: if isSignedIn() && isTeacher()
                    && request.resource.data.teacherId == uid()
                    && classData(request.resource.data.classId).teacherId == uid()
                    && request.resource.data.organizationId
                       == classData(request.resource.data.classId).organizationId
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 80
                    && (request.resource.data.description == null
                        || (request.resource.data.description is string
                            && request.resource.data.description.size() <= 300))
                    && request.resource.data.subject is string
                    && request.resource.data.questionIds is list
                    && request.resource.data.questionIds.size() > 0
                    && request.resource.data.questionIds.size() <= 30
                    && request.resource.data.targetStudentIds is list
                    && request.resource.data.targetStudentIds.size() > 0
                    && request.resource.data.targetStudentIds.size() <= 200
                    && request.resource.data.targetCount == request.resource.data.questionIds.size()
                    && request.resource.data.status in ['draft', 'published']
                    && (request.resource.data.dueAt == null || request.resource.data.dueAt is number)
                    // Phase 44 — the intervention attribution marker. Not a
                    // security-relevant field (it grants nothing — see
                    // interventionEffectiveness.ts's own header), but its
                    // SHAPE is validated at the same strictness as every
                    // other field here, so a malformed value can never reach
                    // a client whose parser expects exactly {subject, topic}.
                    // .get('interventionOf', null) rather than plain dot
                    // access: the field is OPTIONAL on write (the client
                    // omits it entirely for an ordinary assignment — see
                    // assignmentService.ts's createAssignment, and every
                    // pre-Phase-44 test fixture), and reading a genuinely
                    // absent key with dot notation is an evaluation ERROR in
                    // Firestore rules, not null.
                    && (request.resource.data.get('interventionOf', null) == null
                        || (request.resource.data.interventionOf is map
                            && request.resource.data.interventionOf.subject is string
                            && request.resource.data.interventionOf.subject.size() > 0
                            && request.resource.data.interventionOf.topic is string
                            && request.resource.data.interventionOf.topic.size() > 0));

      // Everything that defines WHAT the assignment IS (class, org,
      // teacher, subject/topic/grade, the question/target snapshots,
      // targetCount, createdAt) is frozen after creation — only
      // description/dueAt/status may ever change, matching
      // questions/{questionId}'s own "posterRole/classId/visibility are
      // immutable" precedent for the identical reason: an edit must never
      // be able to smuggle in a different snapshot than the one students
      // were shown.
      allow update: if isSignedIn() && isTeacher()
                    && classData(resource.data.classId).teacherId == uid()
                    && request.resource.data.classId == resource.data.classId
                    && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.teacherId == resource.data.teacherId
                    && request.resource.data.title == resource.data.title
                    && request.resource.data.subject == resource.data.subject
                    && request.resource.data.topic == resource.data.topic
                    && request.resource.data.gradeLevel == resource.data.gradeLevel
                    && request.resource.data.questionIds == resource.data.questionIds
                    && request.resource.data.targetStudentIds == resource.data.targetStudentIds
                    && request.resource.data.targetCount == resource.data.targetCount
                    && request.resource.data.createdAt == resource.data.createdAt
                    // Phase 44 — frozen for the same reason questionIds/
                    // targetStudentIds are: a teacher (or a bug) must never
                    // be able to retroactively turn an ordinary assignment
                    // into an intervention, or vice versa, after the fact.
                    // .get(key, null) rather than plain dot access: a
                    // pre-Phase-44 document has no interventionOf field at
                    // all, and reading a genuinely absent field with dot
                    // notation is an evaluation ERROR in Storage/Firestore
                    // rules (not null) — the exact "Property X is undefined
                    // on object" failure this app's own Phase 33 audit
                    // already documented for an unrelated list query. .get()
                    // is the safe, documented way to read a possibly-absent
                    // key, so updateAssignmentStatus's status-only updates on
                    // legacy assignments keep working unchanged.
                    && request.resource.data.get('interventionOf', null)
                       == resource.data.get('interventionOf', null)
                    && request.resource.data.status in ['draft', 'published', 'archived'];

      allow delete: if isSignedIn() && isTeacher() && classData(resource.data.classId).teacherId == uid();
    }

    // ---- assignments/{assignmentId}/submissions/{studentId} --------------
    // One student's own progress against one assignment — never written by
    // a Cloud Function. A plain client-side transaction is safe here (see
    // assignmentService.ts's recordAssignmentProgress) because nothing in
    // this document is server-computed scheduling state (that stays
    // recordStudyOutcome's alone); this only records which of the
    // assignment's OWN questionIds the student has answered.
    match /assignments/{assignmentId}/submissions/{studentId} {
      allow read: if isSignedIn()
                  && (
                       isOwner(studentId)
                       || (isTeacher() && classData(assignmentData(assignmentId).classId).teacherId == uid())
                     );

      // Every progress write REPLACES the whole document (tx.set, never a
      // partial merge — see assignmentService.ts), so create/update share
      // one rule. hasOnly(...) rejects a student ever claiming to have
      // completed a question that isn't actually part of THIS assignment.
      // Phase 31 — questionOutcomes is OPTIONAL (older/simpler writes with
      // no such field still pass, so this never breaks the write path
      // above) but, when present, its keys must be a real subset of THIS
      // assignment's own questionIds — same hasOnly() containment check
      // completedQuestionIds already uses, applied to the map's keys.
      allow create, update: if isSignedIn()
                    && studentId == uid()
                    && studentId in assignmentData(assignmentId).targetStudentIds
                    && request.resource.data.studentId == studentId
                    && request.resource.data.completedQuestionIds is list
                    && request.resource.data.completedQuestionIds
                       .hasOnly(assignmentData(assignmentId).questionIds)
                    && request.resource.data.completedCount
                       == request.resource.data.completedQuestionIds.size()
                    && (!("questionOutcomes" in request.resource.data)
                        || (request.resource.data.questionOutcomes is map
                            && request.resource.data.questionOutcomes.keys()
                               .hasOnly(assignmentData(assignmentId).questionIds)));

      allow delete: if false;
    }

    // ---- usernames/{username} ------------------------------------------
    // Written exclusively by the setUsername Cloud Function (Admin SDK,
    // bypasses these rules) as a uniqueness reservation. Never read or
    // written by clients directly.

    // ---- classJoinCodes/{code} ------------------------------------------
    // Same uniqueness-reservation pattern as usernames/{username} above —
    // written exclusively by createClass / regenerateClassJoinCode (Admin
    // SDK). Never read or written by clients; joinClassByCode resolves a
    // code to a classId server-side instead of the client querying this
    // collection directly, so a client can't enumerate valid codes.

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
